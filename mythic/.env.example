# Mythic server configuration template.
# Copy the generated Mythic/.env to a protected location on the server.
# Never commit the real .env file or passwords to Git.

COMPOSE_PROJECT_NAME=mythic
GLOBAL_SERVER_NAME=mythic
DEBUG_LEVEL=info

# Operator web UI / reverse proxy.
# Keep the UI behind TLS and authentication.
NGINX_PORT=7443

# Generate strong unique values on the server; do not reuse repository examples.
MYTHIC_ADMIN_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
HASURA_SECRET=CHANGE_ME

# Persistent service settings.
DEFAULT_OPERATION_NAME=Authorized-Lab
DOCUMENTATION_BIND_LOCALHOST_ONLY=true
HASURA_BIND_LOCALHOST_ONLY=true
JUPYTER_BIND_LOCALHOST_ONLY=true

# Do not enable remote C2 services from this repository template.
# Install only components that are explicitly authorized for your own lab.
